# mock: offline; deepseek: real API (restart after changing).
AI_PROVIDER=mock
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
AI_KEY_MODE=development
# Required only for deepseek. Fill locally; never commit or print the value.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_MS=15000
# Per-process in-flight provider limit (1-100); not a distributed cost quota.
AI_MAX_CONCURRENT=2
# Optional allowlist JSON diagnostics; never logs content/headers/keys.
AI_LOG_REQUESTS=false
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# user 模式预留但禁用：必须先接入正式身份认证及密钥治理。
