# Copy to .env and adjust. `npm run dev` / `npm start` load this file automatically.

# http = forward uploads to the PaddleOCR service in ../ocr-service (default)
# mock = fixed sample text "1+1=?" (only for UI work without a model)
OCR_PROVIDER=http
OCR_API_BASE=http://127.0.0.1:8001

# First recognition after a cold start also loads the models (~20s).
OCR_TIMEOUT_MS=120000
