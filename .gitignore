# Installed dependencies
**/node_modules/
.local-ai-deps/
**/__pycache__/
ai-service/work/

# Local application data and uploaded files
back/data/
back/uploads/
# 路径写错时误建的数据目录（真正的数据在 back/data/）
back/db/data/

# Local environment configuration
.env
.env.*
!.env.example

# Logs and operating-system files
*.log
.DS_Store
Thumbs.db

# Python OCR service artifacts
ocr-service/__pycache__/
ocr-service/.paddlex/

# OCR trial build output and sample images
ocr-trial/dist/
ocr-trial/models/
ocr-trial/samples/

# 浏览器端 OCR 运行时产物（71MB），用 node tools/prepare-ocr-web.cjs 生成
fronted/vendor/ocr/

# Word/PPT ZIP runtime: node tools/prepare-office-text.cjs
fronted/vendor/office/

# Local credentials and update snapshots
back/data/local-ai/
.local-update-backup-*/

.local-service-processes.json
.header-service-backup-*/

# Machine-local state, repair snapshots and generated screenshots
.*-backup-*/
artifacts/
**/.local/
modules/mindmap/storage/
*.lnk
